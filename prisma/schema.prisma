generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ExecutionStatus {
  PENDING
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
}

enum StepKind {
  MODEL_CALL
  TOOL_CALL
  TOOL_RESULT
  FINAL_ANSWER
  POSTCONDITION_CHECK
  RUNTIME_FAILURE
  APPROVAL_REQUIRED
  APPROVAL_APPROVED
  APPROVAL_DENIED
}

enum AgentIntegration {
  REFERENCE
  EXTERNAL
}

enum PrincipalType {
  OPERATOR
  AGENT
  EXECUTOR
}

model Owner {
  id         String      @id @default(cuid())
  name       String
  agents     Agent[]
  principals Principal[]
  externalVersions ExternalAgentVersion[]
  manifests ToolManifest[]
  tools ToolRevision[]
  deployments ExecutorDeployment[]
  grants CapabilityGrant[]
  resourceBindings TrustedResourceBinding[]
  executorClaims ExecutorClaim[]
  createdAt  DateTime    @default(now())
}

model Principal {
  id           String        @id @default(cuid())
  ownerId      String
  owner        Owner         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  type         PrincipalType
  agentId      String?
  agent        Agent?        @relation(fields: [ownerId, agentId], references: [ownerId, id], onDelete: Restrict)
  deploymentId String?
  credentials  Credential[]
  issuedGrants CapabilityGrant[]
  approvedBindings TrustedResourceBinding[]
  executorClaims ExecutorClaim[]
  executorSessions ExecutorSession[]
  reconciliationFindings OperatorFinding[]
  externalApprovalDecisions ExternalApprovalDecision[]
  createdAt    DateTime      @default(now())

  @@index([ownerId])
  @@unique([ownerId, id])
}

model Credential {
  id         String    @id @default(cuid())
  principalId String
  principal  Principal @relation(fields: [principalId], references: [id], onDelete: Restrict)
  verifier   String    @unique
  scopes     String[]
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  invocationAuthorizations InvocationAuthorization[]
  executorClaims ExecutorClaim[]
  executorSessions ExecutorSession[]
  reconciliationFindings OperatorFinding[]
  externalApprovalDecisions ExternalApprovalDecision[]

  @@index([principalId])
  @@unique([principalId, id])
}

model Agent {
  id          String         @id @default(cuid())
  name        String         @unique
  ownerId     String         @default("foundry-local-owner")
  owner       Owner          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  integration AgentIntegration @default(REFERENCE)
  description String?
  principals  Principal[]
  externalVersions ExternalAgentVersion[]
  versions    AgentVersion[]
  tasks       Task[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([ownerId, id])
}

model ExternalAgentVersion {
  id String @id @default(cuid())
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  agentId String
  agent Agent @relation(fields: [ownerId, agentId], references: [ownerId, id], onDelete: Restrict)
  version Int
  config Json
  digest String
  createdAt DateTime @default(now())
  manifests ToolManifest[]
  grants CapabilityGrant[]
  runs ExternalRun[]

  @@unique([agentId, version])
  @@unique([ownerId, id])
  @@unique([ownerId, agentId, id])
}

model ToolManifest {
  id String @id @default(cuid())
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versionId String
  version ExternalAgentVersion @relation(fields: [ownerId, versionId], references: [ownerId, id], onDelete: Restrict)
  revision Int
  digest String
  sealed Boolean @default(false)
  createdAt DateTime @default(now())
  tools ToolRevision[]

  @@unique([versionId, revision])
  @@unique([ownerId, versionId, id])
}

model ToolRevision {
  id String @id @default(cuid())
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versionId String
  manifestId String
  manifest ToolManifest @relation(fields: [ownerId, versionId, manifestId], references: [ownerId, versionId, id], onDelete: Restrict)
  name String
  revision Int
  description String
  inputSchema Json
  declaredProfile EffectProfile
  handlerId String
  digest String
  grants CapabilityGrant[]
  invocations Invocation[]

  resourceBindings TrustedResourceBinding[]

  @@unique([manifestId, name])
  @@unique([ownerId, versionId, id])
}

enum EffectProfile {
  READ_ONLY
  WRITE
  DESTRUCTIVE
  EXTERNAL_WRITE
}

model ExecutorDeployment {
  id String @id @default(cuid())
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name String
  environment String
  createdAt DateTime @default(now())
  grants CapabilityGrant[]
  invocations Invocation[]
  resourceBindings TrustedResourceBinding[]
  claims ExecutorClaim[]
  sessions ExecutorSession[]

  @@unique([ownerId, name, environment])
  @@unique([ownerId, id])
}

model CapabilityGrant {
  id String @id @default(cuid())
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versionId String
  version ExternalAgentVersion @relation(fields: [ownerId, versionId], references: [ownerId, id], onDelete: Restrict)
  toolId String
  tool ToolRevision @relation(fields: [ownerId, versionId, toolId], references: [ownerId, versionId, id], onDelete: Restrict)
  deploymentId String
  deployment ExecutorDeployment @relation(fields: [ownerId, deploymentId], references: [ownerId, id], onDelete: Restrict)
  reviewedProfile EffectProfile
  allowedResources String[]
  issuedByPrincipalId String
  issuedBy Principal @relation(fields: [ownerId, issuedByPrincipalId], references: [ownerId, id], onDelete: Restrict)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  invocations Invocation[]

  @@index([ownerId, versionId, toolId, deploymentId, revokedAt])
  @@unique([ownerId, versionId, toolId, deploymentId, id])
}

model TrustedResourceBinding {
  id String @id @default(cuid())
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versionId String
  toolId String
  tool ToolRevision @relation(fields: [ownerId, versionId, toolId], references: [ownerId, versionId, id], onDelete: Restrict)
  deploymentId String
  deployment ExecutorDeployment @relation(fields: [ownerId, deploymentId], references: [ownerId, id], onDelete: Restrict)
  revision Int
  mode String
  artifactDigest String
  executionProfile String?
  outputResource String?
  ledgerId String?
  toolDigest String
  deploymentDigest String
  approvedByPrincipalId String
  approvedBy Principal @relation(fields: [ownerId, approvedByPrincipalId], references: [ownerId, id], onDelete: Restrict)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  authorizations InvocationAuthorization[]
  sessions ExecutorSession[]
  ledgerAnchor ExecutorLedgerAnchor?

  @@unique([toolId, deploymentId, revision])
  @@index([ownerId, versionId, toolId, deploymentId, revokedAt])
  @@unique([ownerId, deploymentId, id])
}

model InvocationAuthorization {
  invocationId String @id
  runId String
  invocation Invocation @relation(fields: [runId, invocationId], references: [runId, id], onDelete: Restrict)
  bindingId String
  binding TrustedResourceBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  credentialId String
  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  snapshot Json
  digest String
  createdAt DateTime @default(now())
  claims ExecutorClaim[]

  @@unique([runId, invocationId])
  @@unique([invocationId, digest])
}

enum ExecutorClaimStatus {
  ACTIVE
  RELEASED
  EXPIRED
  REVOKED
}

model ExecutorClaim {
  id String @id @default(cuid())
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  runId String
  invocationId String
  invocation Invocation @relation(fields: [ownerId, deploymentId, runId, invocationId], references: [ownerId, deploymentId, runId, id], onDelete: Restrict)
  deploymentId String
  deployment ExecutorDeployment @relation(fields: [ownerId, deploymentId], references: [ownerId, id], onDelete: Restrict)
  executorPrincipalId String
  executor Principal @relation(fields: [ownerId, executorPrincipalId], references: [ownerId, id], onDelete: Restrict)
  credentialId String
  credential Credential @relation(fields: [executorPrincipalId, credentialId], references: [principalId, id], onDelete: Restrict)
  requestKey String
  authorizationDigest String
  authorization InvocationAuthorization @relation(fields: [invocationId, authorizationDigest], references: [invocationId, digest], onDelete: Restrict)
  generation Int
  status ExecutorClaimStatus @default(ACTIVE)
  leaseExpiresAt DateTime
  startAuthorizedAt DateTime?
  sessionId String?
  session ExecutorSession? @relation(fields: [ownerId, deploymentId, executorPrincipalId, credentialId, sessionId], references: [ownerId, deploymentId, executorPrincipalId, credentialId, id], onDelete: Restrict)
  starts ExecutorStart[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt DateTime?

  @@unique([invocationId, generation])
  @@unique([ownerId, executorPrincipalId, requestKey])
  @@index([ownerId, deploymentId, status, leaseExpiresAt])
  @@unique([invocationId, id, generation, sessionId])
}

model ExecutorSession {
  id String @id @default(cuid())
  ownerId String
  deploymentId String
  deployment ExecutorDeployment @relation(fields: [ownerId, deploymentId], references: [ownerId, id], onDelete: Restrict)
  executorPrincipalId String
  executor Principal @relation(fields: [ownerId, executorPrincipalId], references: [ownerId, id], onDelete: Restrict)
  credentialId String
  credential Credential @relation(fields: [executorPrincipalId, credentialId], references: [principalId, id], onDelete: Restrict)
  bindingId String
  binding TrustedResourceBinding @relation(fields: [ownerId, deploymentId, bindingId], references: [ownerId, deploymentId, id], onDelete: Restrict)
  sessionKey String
  requestDigest String
  artifactDigest String
  ledgerId String
  executionProfile String
  generation Int
  active Boolean @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  claims ExecutorClaim[]

  @@unique([ownerId, deploymentId, sessionKey])
  @@unique([ownerId, deploymentId, generation])
  @@unique([ownerId, deploymentId, executorPrincipalId, credentialId, id])
}

model ExecutorStart {
  id String @id @default(cuid())
  invocationId String @unique
  invocation Invocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  claimId String @unique
  generation Int
  sessionId String
  claim ExecutorClaim @relation(fields: [invocationId, claimId, generation, sessionId], references: [invocationId, id, generation, sessionId], onDelete: Restrict)
  requestKey String
  requestDigest String
  authorizationDigest String
  artifactDigest String
  startDeadline DateTime
  resultDeadline DateTime
  createdAt DateTime @default(now())
  reports ExecutorReport[]
  approvalConsumption ExternalApprovalConsumption?
}

model ExecutorReport {
  id String @id @default(cuid())
  startId String
  start ExecutorStart @relation(fields: [startId], references: [id], onDelete: Restrict)
  outcome InvocationStatus
  reason String
  result Json?
  digest String
  createdAt DateTime @default(now())

  @@unique([startId, digest])
}

enum ExternalRunStatus {
  RUNNING
  COMPLETED
}

enum InvocationStatus {
  REQUESTED
  READY
  PENDING_APPROVAL
  CLAIMED
  START_AUTHORIZED
  RUNNING
  SUCCEEDED
  FAILED
  DENIED
  REVOKED
  EXPIRED
  UNKNOWN
}

model ExternalRun {
  id String @id
  ownerId String
  agentId String
  versionId String
  version ExternalAgentVersion @relation(fields: [ownerId, agentId, versionId], references: [ownerId, agentId, id], onDelete: Restrict)
  status ExternalRunStatus @default(RUNNING)
  createdAt DateTime @default(now())
  completedAt DateTime?
  invocations Invocation[]

  @@unique([ownerId, agentId, versionId, id])
}

model Invocation {
  id String @id @default(cuid())
  ownerId String
  agentId String
  versionId String
  runId String
  run ExternalRun @relation(fields: [ownerId, agentId, versionId, runId], references: [ownerId, agentId, versionId, id], onDelete: Restrict)
  toolId String
  tool ToolRevision @relation(fields: [ownerId, versionId, toolId], references: [ownerId, versionId, id], onDelete: Restrict)
  deploymentId String
  deployment ExecutorDeployment @relation(fields: [ownerId, deploymentId], references: [ownerId, id], onDelete: Restrict)
  grantId String?
  grant CapabilityGrant? @relation(fields: [ownerId, versionId, toolId, deploymentId, grantId], references: [ownerId, versionId, toolId, deploymentId, id], onDelete: Restrict)
  idempotencyKey String
  arguments Json
  fingerprint String
  status InvocationStatus
  reason String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events InvocationEvent[]
  operatorFindings OperatorFinding[]
  externalApproval ExternalApprovalRequest?
  authorization InvocationAuthorization?
  claims ExecutorClaim[]
  start ExecutorStart?

  @@unique([ownerId, runId, idempotencyKey])
  @@unique([runId, id])
  @@unique([ownerId, deploymentId, runId, id])
}

model InvocationEvent {
  sequence BigInt @id @default(autoincrement())
  runId String
  invocationId String
  invocation Invocation @relation(fields: [runId, invocationId], references: [runId, id], onDelete: Restrict)
  actorPrincipalId String
  kind String
  status InvocationStatus
  reason String
  authorization Json?
  claimId String?
  claimGeneration Int?
  leaseExpiresAt DateTime?
  startId String?
  reportId String?
  executionResult Json?
  findingId String?
  externalApprovalId String?
  createdAt DateTime @default(now())

  @@index([runId, sequence])
  @@index([invocationId, sequence])
}

model AgentVersion {
  id                 String    @id @default(cuid())
  agentId            String
  agent              Agent     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  version            Int
  systemInstructions String
  modelProvider      String
  modelName          String
  maxSteps           Int
  toolPolicies       Json
  taskRuns           TaskRun[]
  createdAt          DateTime  @default(now())

  @@unique([agentId, version])
}

model Task {
  id        String          @id @default(cuid())
  agentId   String
  agent     Agent           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  prompt    String
  postconditions Json @default("[]")
  workspaceRoot String
  status    ExecutionStatus @default(PENDING)
  runs      TaskRun[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model TaskRun {
  id             String          @id @default(cuid())
  taskId         String
  task           Task            @relation(fields: [taskId], references: [id], onDelete: Restrict)
  agentVersionId String
  agentVersion   AgentVersion    @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  status         ExecutionStatus @default(PENDING)
  finalAnswer    String?
  failureReason  String?
  failureMessage String?
  workerId       String?
  heartbeatAt    DateTime?
  recoveryCount Int             @default(0)
  steps          Step[]
  approvals      Approval[]
  evalRun        EvalRun?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([status, heartbeatAt])
}

model Approval {
  id                 String         @id @default(cuid())
  taskRunId          String
  taskRun            TaskRun        @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  toolName            String
  validatedArguments Json
  resumeMessages     Json
  runtimeStep         Int
  status              ApprovalStatus @default(PENDING)
  requestedAt         DateTime       @default(now())
  decidedAt           DateTime?
  consumedAt          DateTime?

  @@index([status, requestedAt])
  @@index([taskRunId, requestedAt])
}

model Step {
  id        String   @id @default(cuid())
  taskRunId String
  taskRun   TaskRun  @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  sequence  Int
  kind      StepKind
  payload   Json
  createdAt DateTime @default(now())

  @@unique([taskRunId, sequence])
}

model EvalRun {
  id             String   @id @default(cuid())
  caseId         String
  caseRevision   String
  caseDefinition Json
  taskRunId      String   @unique
  taskRun        TaskRun  @relation(fields: [taskRunId], references: [id], onDelete: Restrict)
  result         Json?
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([caseId, createdAt])
}


// Installation continuity marker. Never reset when replacing a container.
model ExecutorLedgerAnchor {
  bindingId String @id
  binding TrustedResourceBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  proofDigest String
  createdAt DateTime @default(now())
}

// An operator finding is not an execution result or permission to retry.
model OperatorFinding {
  id String @id @default(cuid())
  invocationId String
  invocation Invocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  ownerId String
  actorPrincipalId String
  actor Principal @relation(fields: [ownerId, actorPrincipalId], references: [ownerId, id], onDelete: Restrict)
  credentialId String
  credential Credential @relation(fields: [actorPrincipalId, credentialId], references: [principalId, id], onDelete: Restrict)
  requestKey String
  requestDigest String
  basisSequence BigInt
  decision String
  reason String
  evidence Json
  createdAt DateTime @default(now())

  @@unique([ownerId, invocationId, requestKey])
  @@unique([invocationId, basisSequence])
}


model ExternalApprovalRequest {
  id String @id @default(cuid())
  invocationId String @unique
  invocation Invocation @relation(fields: [invocationId], references: [id], onDelete: Restrict)
  ownerId String
  authorizationDigest String
  identity Json
  digest String
  expiresAt DateTime
  createdAt DateTime @default(now())
  decision ExternalApprovalDecision?
  consumption ExternalApprovalConsumption?
}

model ExternalApprovalDecision {
  approvalId String @id
  approval ExternalApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  ownerId String
  actorPrincipalId String
  actor Principal @relation(fields: [ownerId, actorPrincipalId], references: [ownerId, id], onDelete: Restrict)
  credentialId String
  credential Credential @relation(fields: [actorPrincipalId, credentialId], references: [principalId, id], onDelete: Restrict)
  requestKey String
  requestDigest String
  decision String
  reason String
  createdAt DateTime @default(now())
}

model ExternalApprovalConsumption {
  approvalId String @id
  approval ExternalApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  startId String @unique
  start ExecutorStart @relation(fields: [startId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}
